(footprint "TCRT5000_NoClip"
  (version 20240108)
  (generator "konnect")
  (layer "F.Cu")
  (descr "Vishay TCRT5000 reflective sensor, 4 leads only (no mounting-clip holes). Pins 1 C, 2 E (detector); 3 A, 4 K (IR LED).")
  (attr through_hole)
  (pad "1" thru_hole rect (at 0 0) (size 2 2) (layers "*.Cu" "*.Mask") (drill 1) )
  (pad "2" thru_hole circle (at 0 2.54) (size 2 2) (layers "*.Cu" "*.Mask") (drill 1) )
  (pad "3" thru_hole circle (at 5.5 2.54) (size 2 2) (layers "*.Cu" "*.Mask") (drill 1) )
  (pad "4" thru_hole circle (at 5.5 0) (size 2 2) (layers "*.Cu" "*.Mask") (drill 1) )
  (fp_rect (start -1.5000 -1.5000) (end 7.0000 4.0400) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_rect (start -1.1500 -1.1500) (end 6.6500 3.6900) (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_poly (pts (xy -2.3500 -0.6300) (xy -1.3500 -1.6300) (xy 7.8500 -1.6300) (xy 7.8500 4.1700) (xy -2.3500 4.1700)) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_circle (center -1.5500 0.0000) (end -1.4000 0.0000) (stroke (width 0.1) (type solid)) (fill solid) (layer "F.SilkS"))
  (fp_text reference "REF**" (at 2.7500 -2.5000 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "TCRT5000_NoClip" (at 2.7500 5.0400 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (model "${KICAD10_3DMODEL_DIR}/OptoDevice.3dshapes/Vishay_TCRT5000.step"
    (offset (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0)))
)